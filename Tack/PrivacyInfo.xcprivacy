<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Tack is fully offline: no accounts, no network requests, no analytics
         and no third-party SDKs. Nothing is collected, so the collected-data
         array is empty — and it must keep telling exactly the same story as
         the App Privacy answers in App Store Connect, which Apple compares. -->
    <key>NSPrivacyTracking</key>
    <false/>
    <key>NSPrivacyTrackingDomains</key>
    <array/>
    <key>NSPrivacyCollectedDataTypes</key>
    <array/>

    <!-- Required-reason APIs. Only what the code actually calls: an earlier
         version of this file also declared DiskSpace and SystemBootTime, which
         nothing in the app touches.

         The exact key and value spellings matter — Apple rejects the build
         with ITMS-91056 and does not say which entry is wrong. It is
         NSPrivacyAccessedAPITypeReasons (not …APIReasons), the categories are
         NSPrivacyAccessedAPICategory… (not NSPrivacyAccessedAPI…), and the
         UserDefaults reason is CA92.1 (CA1007 is not a valid code). -->
    <key>NSPrivacyAccessedAPITypes</key>
    <array>
        <!-- AppSettings (@AppStorage) plus the first-launch demo-seed flag. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryUserDefaults</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>CA92.1</string>
            </array>
        </dict>
        <!-- ObsidianVault reads .contentModificationDateKey to decide which
             side of the sync is newer. -->
        <dict>
            <key>NSPrivacyAccessedAPIType</key>
            <string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
            <key>NSPrivacyAccessedAPITypeReasons</key>
            <array>
                <string>C617.1</string>
            </array>
        </dict>
    </array>
</dict>
</plist>
