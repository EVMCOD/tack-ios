default_platform(:ios)

# ─────────────────────────────────────────────────────────────────────
# iOS App
# ─────────────────────────────────────────────────────────────────────
platform :ios do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Verify clean build + run UI tests (iOS)"
  lane :test do
    scan(
      project: "Tack.xcodeproj",
      scheme: "Tack",
      destination: "platform=iOS Simulator,name=iPhone 17 Pro",
      derived_data_path: "./build/derived",
      output_directory: "./build/test_output",
      clean: true
    )
  end

  desc "Archive for App Store distribution (iOS)"
  lane :archive do
    sync_code_signing(
      type: "app-store",
      app_identifier: ["app.tack.ios", "app.tack.ios.widget"],
      readonly: false
    )
    gym(
      project: "Tack.xcodeproj",
      scheme: "Tack",
      configuration: "Release",
      output_directory: "./build",
      output_name: "Tack.ipa",
      archive_path: "./build/Tack.xcarchive",
      export_method: "app-store",
      include_symbols: false,
      clean: true
    )
  end

  desc "Capture App Store screenshots (iOS)"
  lane :screenshots do
    capture_screenshots(
      project: "Tack.xcodeproj",
      scheme: "Tack",
      output_directory: "./build/screenshots",
      output_simulator_dir: "./build/screenshots/sim",
      clear_previous_screenshots: true,
      override_status_bar: true,
      devices: [
        "iPhone 17 Pro",
        "iPhone Air"
      ],
      languages: [
        "en-US",
        "es-ES",
        "fr-FR",
        "de-DE",
        "it-IT",
        "pt-BR"
      ]
    )
  end

  desc "Upload to App Store Connect (iOS, no submit)"
  lane :upload do
    deliver(
      app_identifier: "app.tack.ios",
      username: ENV["APPLE_ID_FOR_TACK"] || "valerosenrique@gmail.com",
      team_id: "KADHS6P8PY",
      ipa: "./build/Tack.ipa",
      metadata_path: "./metadata",
      screenshots_path: "./build/screenshots",
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      skip_app_version_update: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      clean_screenshots: true,
      force: true,
      run_precheck_before_submit: true,
      reject_if_possible: true
    )
  end

  desc "Full ship lane (iOS): test → archive → screenshots → upload"
  lane :ship do
    test
    archive
    screenshots
    upload
  end

  desc "Register bundle ID + widget + App Group (one-time)"
  lane :register do
    produce(
      app_identifier: "app.tack.ios",
      app_name: "Tack",
      language: "en-US",
      enable_services: {
        app_group: :on
      }
    )
  end

  error do |lane, exception|
    UI.error("iOS lane #{lane} failed: #{exception.message}")
  end
end

# ─────────────────────────────────────────────────────────────────────
# macOS App
# ─────────────────────────────────────────────────────────────────────
platform :mac do
  before_all do
    setup_ci if ENV["CI"]
  end

  desc "Verify clean build for macOS"
  lane :test do
    build_mac_app(
      project: "Tack.xcodeproj",
      scheme: "TackMac",
      configuration: "Debug",
      skip_codesigning: true,
      skip_archive: true,
      skip_package_pkg: true,
      output_directory: "./build/mac-debug"
    )
  end

  desc "Archive for App Store distribution (macOS, produces .pkg)"
  lane :archive do
    sync_code_signing(
      type: "app-store",
      app_identifier: "app.tack.macos",
      readonly: false
    )
    gym(
      project: "Tack.xcodeproj",
      scheme: "TackMac",
      configuration: "Release",
      output_directory: "./build/mac",
      output_name: "TackMac.pkg",
      archive_path: "./build/TackMac.xcarchive",
      export_method: "app-store",
      include_symbols: false,
      clean: true
    )
  end

  desc "Capture App Store screenshots (macOS — manual flow)"
  lane :screenshots do
    UI.important("macOS screenshots are captured manually — see scripts/mac-screenshot.sh")
    sh("bash ./scripts/mac-screenshot.sh")
  end

  desc "Upload to App Store Connect (macOS, no submit)"
  lane :upload do
    deliver(
      app_identifier: "app.tack.macos",
      username: ENV["APPLE_ID_FOR_TACK"] || "valerosenrique@gmail.com",
      team_id: "KADHS6P8PY",
      pkg: "./build/mac/TackMac.pkg",
      metadata_path: "./metadata",
      screenshots_path: "./build/screenshots/mac",
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      skip_app_version_update: false,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      clean_screenshots: true,
      force: true,
      run_precheck_before_submit: true,
      reject_if_possible: true
    )
  end

  desc "Full ship lane (macOS): test → archive → screenshots → upload"
  lane :ship do
    test
    archive
    screenshots
    upload
  end

  desc "Register macOS bundle ID + App Group (one-time)"
  lane :register do
    produce(
      app_identifier: "app.tack.macos",
      app_name: "Tack for Mac",
      language: "en-US",
      enable_services: {
        app_group: :on
      }
    )
  end

  error do |lane, exception|
    UI.error("macOS lane #{lane} failed: #{exception.message}")
  end
end
